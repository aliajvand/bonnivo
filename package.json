{
  "name": "bonnivo-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "NODE_ENV=production npm run build --workspace=apps/web && node scripts/copy-build-artifacts.js",
    "start": "node server.js",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web"
  },
  "dependencies": {
    "next": "15.2.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-next": "15.2.1",
    "typescript": "^5.7.2"
  }
}
